{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Order Processing System API",
    "description": "Complete API collection for the Node.js E-Commerce Order Processing System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "REPLACE_WITH_ORDER_ID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Verifies that the server is up and running."
      },
      "response": []
    },
    {
      "name": "2. Create an Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"cust_101\",\n  \"items\": [\n    {\n      \"productId\": \"prod_1\",\n      \"name\": \"Wireless Mouse\",\n      \"quantity\": 2,\n      \"price\": 799\n    },\n    {\n      \"productId\": \"prod_2\",\n      \"name\": \"Mechanical Keyboard\",\n      \"quantity\": 1,\n      \"price\": 2499\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "description": "Creates a new order with multiple items and calculates totalAmount on the server."
      },
      "response": []
    },
    {
      "name": "3. List All Orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders?page=1&limit=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ],
          "query": [
            {
              "key": "status",
              "value": "PENDING",
              "disabled": true,
              "description": "Optional: PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "Lists all orders with optional status filter and pagination."
      },
      "response": []
    },
    {
      "name": "4. Retrieve Order Details by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "{{orderId}}"
          ]
        },
        "description": "Fetches full order details by MongoDB ObjectId."
      },
      "response": []
    },
    {
      "name": "5. Update Order Status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"PROCESSING\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "{{orderId}}",
            "status"
          ]
        },
        "description": "Advances order status (PENDING -> PROCESSING -> SHIPPED -> DELIVERED)."
      },
      "response": []
    },
    {
      "name": "6. Cancel an Order",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}/cancel",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "{{orderId}}",
            "cancel"
          ]
        },
        "description": "Cancels the order (only succeeds if current status is PENDING)."
      },
      "response": []
    }
  ]
}